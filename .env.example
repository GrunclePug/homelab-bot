# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_GUILD_ID=000000000000000000
DISCORD_SUPPORT_CHANNEL_ID=000000000000000000
DISCORD_ADMIN_ROLE_ID=000000000000000000
DISCORD_MEDIA_ROLE_ID=000000000000000000
DISCORD_ACCESS_CHANNEL_ID=000000000000000000
DISCORD_APPROVER_ROLE_ID=000000000000000000

# Seerr
SEERR_URL=http://seerr.example:5055
SEERR_API_KEY=your-seerr-api-key
SEERR_WEBHOOK_SECRET=a-long-random-string
# Optional: the Seerr address members use, for the welcome DM
# SEERR_PUBLIC_URL=https://seerr.example.com

# Plex: the server owner's token and the server's machine identifier
PLEX_TOKEN=your-plex-token
PLEX_SERVER_ID=your-server-machine-identifier

# Sonarr and Radarr
SONARR_URL=http://sonarr.example:8989
SONARR_API_KEY=your-sonarr-api-key
RADARR_URL=http://radarr.example:7878
RADARR_API_KEY=your-radarr-api-key

# qBittorrent Web UI and its API key (qBittorrent 5.2 or newer)
QBIT_URL=http://qbittorrent.example:8080
QBIT_API_KEY=your-qbittorrent-api-key

# Optional: an Uptime Kuma status page whose monitors /status shows
# KUMA_STATUS_URL=https://kuma.example.com/status/homelab

# Optional
# LISTEN_ADDR=:8080
# PORT=8080
# DB_PATH=data/homelab-bot.db
# LOG_LEVEL=info
